
.test-page {
		min-height: 100vh;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 40rpx;
}
.test-header {
		margin-bottom: 60rpx;
}
.test-title {
		font-size: 48rpx;
		font-weight: bold;
		color: white;
		text-align: center;
}
.test-content {
		background: white;
		border-radius: 20rpx;
		padding: 60rpx 40rpx;
		text-align: center;
		box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}
.test-message {
		font-size: 32rpx;
		color: #333;
		margin-bottom: 40rpx;
		display: block;
}
.test-button {
		background: #007aff;
		color: white;
		border: none;
		border-radius: 25rpx;
		padding: 20rpx 40rpx;
		font-size: 28rpx;
		font-weight: bold;
}
.test-button:active {
		background: #0056cc;
}
