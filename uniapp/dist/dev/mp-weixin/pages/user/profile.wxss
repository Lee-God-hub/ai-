.profile-page.data-v-f6b4f04d {
  background: #f5f5f5;
  min-height: 100vh;
}
.user-card.data-v-f6b4f04d {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}
.user-info.data-v-f6b4f04d {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.user-avatar.data-v-f6b4f04d {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text.data-v-f6b4f04d {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}
.user-details.data-v-f6b4f04d {
  flex: 1;
}
.user-name.data-v-f6b4f04d {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}
.user-desc.data-v-f6b4f04d {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
.arrow-icon.data-v-f6b4f04d {
  font-size: 16rpx;
  color: #c0c4cc;
}
.menu-section.data-v-f6b4f04d {
  padding: 0 20rpx;
}
.menu-group.data-v-f6b4f04d {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.menu-item.data-v-f6b4f04d {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item.data-v-f6b4f04d:last-child {
  border-bottom: none;
}
.menu-left.data-v-f6b4f04d {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.menu-left text.data-v-f6b4f04d {
  font-size: 28rpx;
  color: #303133;
}
.menu-icon.data-v-f6b4f04d {
  font-size: 20rpx;
}
.menu-right.data-v-f6b4f04d {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.count-badge.data-v-f6b4f04d {
  background: #f56c6c;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 10rpx;
  min-width: 20rpx;
  text-align: center;
}
.feature-tag.data-v-f6b4f04d {
  background: #ff9500;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}
.action-section.data-v-f6b4f04d {
  padding: 40rpx 20rpx;
}
.login-btn.data-v-f6b4f04d, .logout-btn.data-v-f6b4f04d {
  width: 100%;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
.login-btn.data-v-f6b4f04d {
  background: #3c9cff;
  color: #fff;
}
.logout-btn.data-v-f6b4f04d {
  background: #fff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
}