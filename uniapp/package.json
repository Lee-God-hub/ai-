{
  "name": "smart-property-uniapp",
  "version": "1.0.0",
  "description": "智能房产交易平台 - Uniapp移动端",
  "main": "main.js",
  "scripts": {
    "serve": "npm run dev:h5",
    "build": "npm run build:h5",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
